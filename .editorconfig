# EditorConfig helps maintain consistent coding styles between different editors and IDEs
root = true

# 기본 설정 (모든 파일)
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Java 파일 설정
[*.java]
indent_style = space
indent_size = 4

# Markdown 파일 설정 (줄 끝 공백 허용)
[*.md]
trim_trailing_whitespace = false

# Properties 파일 설정
[*.properties]
charset = utf-8

# SQL 파일 설정
[*.sql]
indent_style = space
indent_size = 4